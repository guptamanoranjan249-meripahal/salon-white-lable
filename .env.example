# Node.js server
NODE_ENV=development
PORT=3000

# The database and image uploads must be stored on persistent storage in production.
DATABASE_PATH=./data/salon-builder.sqlite
UPLOADS_DIR=./uploads

# Public salon URLs. Use PUBLIC_BASE_URL for path-based links such as
# https://yourdomain.com/your-salon, or set PUBLIC_BASE_DOMAIN for wildcard
# subdomains such as https://your-salon.yourdomain.com.
PUBLIC_BASE_URL=http://localhost:3000
# PUBLIC_BASE_DOMAIN=yourdomain.com

# Set true only when the application is behind a trusted reverse proxy.
TRUST_PROXY=false
