# Node.js server
NODE_ENV=development
PORT=3000

# The database and image uploads must live on persistent storage in production.
DATABASE_PATH=./data/salon-builder.sqlite
UPLOADS_DIR=./uploads

# Canonical application origin used for email links and public salon URLs.
# Use HTTPS origins in production.
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Or use wildcard salon subdomains: set PUBLIC_BASE_DOMAIN and configure wildcard DNS/TLS.
# PUBLIC_BASE_DOMAIN=yourdomain.com

# Set true only when the application is behind a trusted reverse proxy.
TRUST_PROXY=false

# Email verification delivery (required in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nexora Salon Studio <no-reply@yourdomain.com>"

# Google OAuth web client. Add this exact callback URL in Google Cloud Console:
# https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
